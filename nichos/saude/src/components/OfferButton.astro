---
/**
 * Botão que leva à página oficial via /go/<slug>.
 * No clique dispara: evento GA4 "offer_click" e a conversão do Google Ads (se configurada).
 */
import { tracking } from '../site.config';
interface Props { slug: string; label: string; position: string; }
const { slug, label, position } = Astro.props;
const sendTo = tracking.googleAdsId && tracking.googleAdsClickLabel
  ? `${tracking.googleAdsId}/${tracking.googleAdsClickLabel}`
  : '';
---
<a
  class="offer ui"
  href={`/go/${slug}`}
  rel="sponsored nofollow"
  data-offer={slug}
  data-position={position}
  data-send-to={sendTo}
>{label}</a>

<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-offer]').forEach((a) => {
    a.addEventListener('click', () => {
      const w = window as unknown as { gtag?: (...args: unknown[]) => void };
      if (typeof w.gtag !== 'function') return;
      w.gtag('event', 'offer_click', { offer: a.dataset.offer, position: a.dataset.position });
      if (a.dataset.sendTo) w.gtag('event', 'conversion', { send_to: a.dataset.sendTo });
    });
  });
</script>

<style>
  .offer {
    display: inline-block;
    background: var(--seaglass);
    color: #ffffff;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
    text-decoration: none;
    padding: 0.95rem 1.5rem;
    border-radius: 0.5rem;
    box-shadow: 0 2px 0 var(--seaglass-dark);
    text-align: center;
  }
  .offer:hover { background: var(--seaglass-dark); color: #ffffff; text-decoration: none; }
  .offer:active { transform: translateY(1px); box-shadow: none; }
  @media (max-width: 30rem) { .offer { display: block; } }
</style>
