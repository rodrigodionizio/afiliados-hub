---
import { site } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="site-footer ui">
  <div class="wrap">
    <p class="note">
      {site.name} is reader-supported. When you buy through links on this site we may earn an affiliate
      commission, at no extra cost to you. <a href="/affiliate-disclosure">Read our affiliate disclosure</a>.
    </p>
    <p class="note">
      Content on this site is for general information only and is not medical or dental advice. Statements
      about dietary supplements have not been evaluated by the Food and Drug Administration. These products are
      not intended to diagnose, treat, cure, or prevent any disease. Talk to your dentist or doctor before
      starting a supplement, especially if you are pregnant, nursing, taking medication, or managing a health condition.
    </p>
    <nav aria-label="Legal" class="links">
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/editorial-policy">Editorial policy</a>
      <a href="/affiliate-disclosure">Affiliate disclosure</a>
      <a href="/medical-disclaimer">Medical disclaimer</a>
      <a href="/privacy">Privacy policy</a>
      <a href="/terms">Terms of use</a>
    </nav>
    <p class="copy">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: 5rem; padding: 2.5rem 0 3rem; background: var(--ink); color: #c9d6d3; font-size: 0.9rem; line-height: 1.6; }
  .note { max-width: 46rem; }
  .site-footer a { color: #ffffff; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; margin: 1.5rem 0; }
  .copy { margin: 0; color: #9fb3af; }
</style>
