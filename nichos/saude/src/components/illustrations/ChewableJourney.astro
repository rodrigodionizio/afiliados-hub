---
/** O caminho de uma pastilha mastigável — sequência real, por isso numerada. */
const steps = [
  { title: 'Chew slowly', text: 'One tablet in the morning, after brushing.' },
  { title: 'Let it dissolve', text: 'It melts in the mouth instead of being swallowed whole.' },
  { title: 'Cultures reach the surfaces', text: 'Teeth, gums and tongue come into contact with the probiotics.' },
  { title: 'Swallow and go', text: 'No water or rinse needed. Keep brushing and flossing as usual.' },
];
---
<figure class="journey">
  <ol class="ui">
    {steps.map((s, i) => (
      <li>
        <svg viewBox="0 0 120 90" aria-hidden="true">
          {i === 0 && (
            <g>
              <ellipse cx="60" cy="52" rx="34" ry="12" fill="#f2c9bf" stroke="#14303a" stroke-width="2.5" />
              <ellipse cx="60" cy="44" rx="34" ry="12" fill="#fbe7e2" stroke="#14303a" stroke-width="2.5" />
              <path d="M22 20 l10 8 M98 20 l-10 8 M60 8 v10" stroke="#22766c" stroke-width="3" stroke-linecap="round" />
            </g>
          )}
          {i === 1 && (
            <g>
              <ellipse cx="60" cy="50" rx="30" ry="10" fill="#fbe7e2" stroke="#14303a" stroke-width="2.5" stroke-dasharray="5 4" />
              <circle cx="30" cy="30" r="4" fill="#22766c" /><circle cx="88" cy="26" r="5" fill="#22766c" /><circle cx="70" cy="18" r="3" fill="#22766c" /><circle cx="46" cy="20" r="3" fill="#22766c" />
            </g>
          )}
          {i === 2 && (
            <g>
              <path d="M10 62 C30 40 50 40 60 52 C70 40 90 40 110 62" fill="#e8b0a9" stroke="#14303a" stroke-width="2.5" />
              <path d="M40 46 C38 24 48 14 60 22 C72 14 82 24 80 46" fill="#ffffff" stroke="#14303a" stroke-width="2.5" />
              <g fill="#22766c"><rect x="28" y="52" width="12" height="6" rx="3" /><rect x="80" y="50" width="12" height="6" rx="3" transform="rotate(20 86 53)" /><rect x="56" y="58" width="12" height="6" rx="3" /></g>
            </g>
          )}
          {i === 3 && (
            <g>
              <path d="M40 14 v40 a20 20 0 0 0 40 0 v-40" fill="none" stroke="#14303a" stroke-width="2.5" />
              <path d="M60 22 v38 m-12 -12 l12 12 l12 -12" fill="none" stroke="#22766c" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            </g>
          )}
        </svg>
        <span class="n">{i + 1}</span>
        <strong>{s.title}</strong>
        <span class="t">{s.text}</span>
      </li>
    ))}
  </ol>
  <figcaption class="ui">How a chewable oral probiotic is meant to be taken, based on the company's directions.</figcaption>
</figure>

<style>
  .journey { margin: 2rem 0; }
  ol { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, minmax(0, 1fr)); counter-reset: none; }
  li { position: relative; background: var(--paper); border: 1px solid var(--rule); border-radius: 0.6rem; padding: 1rem; font-size: 0.95rem; line-height: 1.4; display: grid; gap: 0.35rem; align-content: start; }
  li svg { width: 100%; max-width: 8rem; height: auto; margin-bottom: 0.25rem; }
  .n { position: absolute; top: 0.75rem; right: 0.85rem; width: 1.75rem; height: 1.75rem; border-radius: 50%; background: var(--ink); color: #fff; display: grid; place-items: center; font-weight: 700; font-size: 0.9rem; }
  .t { color: var(--graphite); }
  figcaption { margin-top: 0.75rem; font-size: 0.85rem; color: var(--graphite); }
  @media (min-width: 60rem) { ol { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
