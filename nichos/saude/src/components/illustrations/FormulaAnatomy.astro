---
/** Anatomia da fórmula: pastilha no centro, cepas de um lado e ingredientes de apoio do outro. */
const strains = [
  { name: 'Lactobacillus paracasei', alt: 'now classified as Lacticaseibacillus paracasei', role: 'Included to support gum health', shape: 'rod' },
  { name: 'Bifidobacterium lactis BL-04', alt: '', role: 'Included to support a balanced oral environment', shape: 'bifid' },
  { name: 'Lactobacillus reuteri', alt: 'now classified as Limosilactobacillus reuteri', role: 'A widely studied species, included to support a healthy mouth', shape: 'rod2' },
];
const support = [
  { name: 'Inulin', role: 'Plant fiber that feeds beneficial bacteria' },
  { name: 'Malic acid', role: 'Fruit acid found in strawberries' },
  { name: 'Tricalcium phosphate', role: 'A source of calcium and phosphate' },
  { name: 'Peppermint', role: 'Flavor and a fresh-feeling mouth' },
];
---
<figure class="anatomy">
  <div class="grid ui">
    <div class="col">
      <h3>The probiotic strains</h3>
      <ul>
        {strains.map((s) => (
          <li>
            <svg viewBox="0 0 48 48" aria-hidden="true" class="glyph">
              {s.shape === 'rod' && <rect x="8" y="18" width="32" height="12" rx="6" fill="#22766c" />}
              {s.shape === 'rod2' && (<g fill="#22766c"><rect x="4" y="20" width="20" height="9" rx="4.5" /><rect x="25" y="20" width="20" height="9" rx="4.5" /></g>)}
              {s.shape === 'bifid' && <path d="M10 34 L24 24 L38 34 M24 24 L24 10" stroke="#22766c" stroke-width="7" stroke-linecap="round" fill="none" />}
            </svg>
            <span><strong>{s.name}</strong>{s.alt && <em class="alt">({s.alt})</em>}{s.role}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="tablet" aria-hidden="true">
      <svg viewBox="0 0 220 220">
        <ellipse cx="110" cy="128" rx="84" ry="30" fill="#14303a" opacity=".12" />
        <ellipse cx="110" cy="116" rx="84" ry="30" fill="#f2c9bf" stroke="#14303a" stroke-width="3" />
        <path d="M26 116 L26 96 C26 79 64 66 110 66 C156 66 194 79 194 96 L194 116" fill="#f7d9d2" stroke="#14303a" stroke-width="3" />
        <ellipse cx="110" cy="96" rx="84" ry="30" fill="#fbe7e2" stroke="#14303a" stroke-width="3" />
        <g fill="#22766c">
          <rect x="72" y="88" width="16" height="7" rx="3.5" transform="rotate(-20 80 91)" />
          <rect x="118" y="82" width="16" height="7" rx="3.5" transform="rotate(25 126 85)" />
          <rect x="96" y="102" width="16" height="7" rx="3.5" />
          <rect x="140" y="100" width="16" height="7" rx="3.5" transform="rotate(-35 148 103)" />
        </g>
        <g fill="#ffffff" stroke="#14303a" stroke-width="1.5">
          <circle cx="62" cy="102" r="4" /><circle cx="160" cy="90" r="4" /><circle cx="108" cy="80" r="3.5" />
        </g>
        <text x="110" y="182" text-anchor="middle" font-size="15" font-weight="700" fill="#14303a">3.5 billion probiotics</text>
        <text x="110" y="202" text-anchor="middle" font-size="13" fill="#4f6268">in the blend, company figure</text>
      </svg>
    </div>

    <div class="col">
      <h3>The supporting ingredients</h3>
      <ul>
        {support.map((s) => (
          <li>
            <svg viewBox="0 0 48 48" aria-hidden="true" class="glyph"><circle cx="24" cy="24" r="10" fill="#ffffff" stroke="#14303a" stroke-width="3" /></svg>
            <span><strong>{s.name}</strong>{s.role}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <figcaption class="ui">
    The formula, as listed by the company. Illustration, not to scale.
    The descriptions reflect what the company says each ingredient is for. They have not been evaluated by the
    Food and Drug Administration, and ProDentim is not intended to diagnose, treat, cure or prevent any disease.
  </figcaption>
</figure>

<style>
  .anatomy { margin: 2rem 0; padding: 1.5rem; background: var(--paper); border: 1px solid var(--rule); border-radius: 0.75rem; }
  .grid { display: grid; gap: 1.25rem; }
  h3 { margin: 0 0 0.75rem; font-family: var(--sans); font-size: 1.05rem; }
  ul { list-style: none; padding: 0; margin: 0; }
  li { display: grid; grid-template-columns: 2.25rem 1fr; gap: 0.6rem; align-items: start; margin-bottom: 0.85rem; font-size: 0.95rem; line-height: 1.4; }
  li strong { display: block; }
  .alt { display: block; font-size: 0.85rem; }
  li span { color: var(--graphite); }
  li strong { color: var(--ink); }
  .glyph { width: 2.25rem; height: 2.25rem; }
  .tablet { display: grid; place-items: center; }
  .tablet svg { width: 100%; max-width: 13rem; }
  figcaption { margin-top: 1rem; font-size: 0.85rem; color: var(--graphite); }
  .tablet { order: -1; }
  @media (min-width: 44rem) {
    .grid { grid-template-columns: 1fr 1fr; }
    .tablet { grid-column: 1 / -1; }
  }
</style>
