---
/**
 * Ilustração técnica: corte de dente e gengiva, com a biofilme da linha da gengiva ampliada.
 * Ilustração esquemática, fora de escala.
 */
// posições "aleatórias" estáveis para as bactérias da lupa
function seeded(seed: number) {
  let s = seed;
  return () => ((s = (s * 9301 + 49297) % 233280) / 233280);
}
const rnd = seeded(7);
type Bug = { x: number; y: number; r: number; good: boolean };
const bugs: Bug[] = [];
for (let i = 0; i < 46; i++) {
  const a = rnd() * Math.PI * 2;
  const d = Math.sqrt(rnd()) * 96;
  const x = 600 + Math.cos(a) * d;
  const y = 170 + Math.sin(a) * d;
  if (y > 205) continue; // abaixo da "superfície" fica o tecido
  bugs.push({ x, y, r: rnd() * 180, good: rnd() > 0.28 });
}
---
<svg viewBox="0 0 760 440" role="img" aria-labelledby="tooth-title tooth-desc" class="illus">
  <title id="tooth-title">Cross-section of a tooth and gum</title>
  <desc id="tooth-desc">Schematic drawing of a tooth showing enamel, dentin and pulp sitting in the gum. A magnified circle shows the thin film of bacteria at the gumline, made of mostly helpful bacteria mixed with some less helpful ones.</desc>
  <defs>
    <clipPath id="lens"><circle cx="600" cy="170" r="110" /></clipPath>
    <pattern id="gumtex" width="14" height="14" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
      <line x1="0" y1="0" x2="0" y2="14" stroke="#c98b84" stroke-width="1.2" opacity=".35" />
    </pattern>
  </defs>

  <!-- gengiva (uma peça só, atrás do dente) -->
  <path id="gum" d="M40,440 L40,228 C110,212 170,206 212,216 C226,220 236,232 246,246 C270,236 340,236 366,246 C376,232 386,220 400,216 C420,210 436,214 452,222 L452,440 Z" fill="#e8b0a9" stroke="#14303a" stroke-width="2.5" stroke-linejoin="round" />
  <path d="M40,440 L40,228 C110,212 170,206 212,216 C226,220 236,232 246,246 C270,236 340,236 366,246 C376,232 386,220 400,216 C420,210 436,214 452,222 L452,440 Z" fill="url(#gumtex)" />

  <!-- dente: dentina -->
  <path d="M222,196 C210,124 230,72 268,62 C290,57 298,72 306,72 C314,72 322,57 344,62 C382,72 402,124 390,196 L376,300 C370,362 352,418 334,420 C320,421 314,382 306,334 C298,382 292,421 278,420 C260,418 242,362 236,300 Z" fill="#f4ecd8" stroke="#14303a" stroke-width="3" stroke-linejoin="round" />
  <!-- esmalte -->
  <path d="M222,196 C210,124 230,72 268,62 C290,57 298,72 306,72 C314,72 322,57 344,62 C382,72 402,124 390,196 C364,184 336,180 306,180 C276,180 248,184 222,196 Z" fill="#ffffff" stroke="#14303a" stroke-width="3" stroke-linejoin="round" />
  <path d="M244,180 C238,128 252,92 278,84" fill="none" stroke="#d5e0dc" stroke-width="6" stroke-linecap="round" />
  <!-- polpa -->
  <path d="M282,170 C280,138 332,138 330,170 L322,300 C319,342 312,372 306,372 C300,372 293,342 290,300 Z" fill="#efc0b6" stroke="#14303a" stroke-width="2" />

  <!-- pontos de biofilme na linha da gengiva -->
  <g fill="#22766c">
    <rect x="226" y="205" width="9" height="4.5" rx="2.25" transform="rotate(-30 230 207)" />
    <rect x="232" y="214" width="9" height="4.5" rx="2.25" transform="rotate(20 236 216)" />
    <rect x="376" y="206" width="9" height="4.5" rx="2.25" transform="rotate(30 380 208)" />
    <rect x="370" y="216" width="9" height="4.5" rx="2.25" transform="rotate(-15 374 218)" />
  </g>
  <g fill="#d08a3c"><circle cx="383" cy="198" r="3" /><circle cx="223" cy="216" r="3" /></g>

  <!-- ligação até a lupa -->
  <circle cx="380" cy="210" r="16" fill="none" stroke="#14303a" stroke-width="2" stroke-dasharray="4 4" />
  <line x1="394" y1="203" x2="494" y2="160" stroke="#14303a" stroke-width="2" stroke-dasharray="4 4" />

  <!-- lupa -->
  <circle cx="600" cy="170" r="110" fill="#fafbf8" />
  <g clip-path="url(#lens)">
    <rect x="480" y="205" width="240" height="90" fill="#e8b0a9" />
    <rect x="480" y="205" width="240" height="90" fill="url(#gumtex)" />
    <path d="M480,205 C540,198 660,212 720,203" fill="none" stroke="#14303a" stroke-width="2" />
    {bugs.map((b) =>
      b.good
        ? <rect x={b.x - 9} y={b.y - 4} width="18" height="8" rx="4" fill="#22766c" transform={`rotate(${b.r} ${b.x} ${b.y})`} />
        : <circle cx={b.x} cy={b.y} r="5.5" fill="#d08a3c" stroke="#8a5420" stroke-width="1" />
    )}
  </g>
  <circle cx="600" cy="170" r="110" fill="none" stroke="#14303a" stroke-width="3" />

  <!-- rótulos -->
  <g class="lbl" font-size="22" fill="#14303a">
    <line x1="150" y1="92" x2="240" y2="112" stroke="#14303a" stroke-width="1.5" />
    <text x="40" y="98">Enamel</text>
    <line x1="150" y1="168" x2="246" y2="250" stroke="#14303a" stroke-width="1.5" />
    <text x="40" y="174">Dentin</text>
    <line x1="420" y1="388" x2="314" y2="312" stroke="#14303a" stroke-width="1.5" />
    <text x="426" y="394">Pulp</text>
    <text x="64" y="330">Gum tissue</text>
    <text x="510" y="316" font-weight="700">Gumline, magnified</text>
  </g>
  <g class="lbl" font-size="20" fill="#14303a">
    <rect x="512" y="340" width="20" height="9" rx="4.5" fill="#22766c" />
    <text x="542" y="350">Helpful bacteria</text>
    <circle cx="522" cy="378" r="6" fill="#d08a3c" stroke="#8a5420" />
    <text x="542" y="385">Less helpful bacteria</text>
  </g>
</svg>
