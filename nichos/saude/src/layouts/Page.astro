---
import Base from './Base.astro';
interface Props { title: string; description: string; updated?: string; }
const { title, description, updated } = Astro.props;
---
<Base title={title} description={description}>
  <div class="wrap page">
    <h1>{title}</h1>
    {updated && <p class="updated ui">Last updated {updated}</p>}
    <div class="measure prose"><slot /></div>
  </div>
</Base>

<style>
  .page { padding-top: 2.5rem; }
  .updated { color: var(--graphite); font-size: 0.95rem; margin-top: -0.5rem; }
  .prose { font-size: 1.05rem; }
</style>
