---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';

const articles = [
  {
    href: '/prodentim',
    title: "The mouth has a microbiome too. Here's what an oral probiotic like ProDentim is designed to do",
    summary: 'What researchers are learning about the bacteria in your mouth, what oral probiotics can and cannot do, and an honest look at one of them.',
    topic: 'Oral health',
    updated: 'October 16, 2026',
  },
];
---
<Base title={site.name} description={site.tagline}>
  <section class="wrap intro">
    <h1>Notes on everyday health products, written for grown-ups.</h1>
    <p class="lede">
      We read the label, the research and the fine print, then write it down plainly: what a product is,
      what it costs, what the evidence says, and who should skip it.
    </p>
  </section>

  <section class="wrap" aria-labelledby="latest">
    <h2 id="latest" class="section-title">Latest notes</h2>
    <ul class="list">
      {articles.map((a) => (
        <li>
          <a class="card" href={a.href}>
            <span class="topic ui">{a.topic}</span>
            <span class="title">{a.title}</span>
            <span class="summary">{a.summary}</span>
            <span class="date ui">Updated {a.updated}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .intro { padding: 3.5rem var(--gutter) 2rem; }
  .intro h1 { max-width: 20ch; font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem); }
  .lede { max-width: 36rem; font-size: 1.25rem; color: var(--graphite); }
  .section-title { font-size: 1.25rem; margin-top: 1rem; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .card {
    display: grid; gap: 0.5rem; padding: 1.5rem; max-width: 46rem;
    background: var(--paper); border: 1px solid var(--rule); border-radius: 0.6rem;
    text-decoration: none; color: var(--ink);
  }
  .card:hover { border-color: var(--seaglass); }
  .card:hover .title { text-decoration: underline; }
  .topic { font-size: 0.85rem; color: var(--seaglass); font-weight: 700; }
  .title { font-size: 1.4rem; font-weight: 650; line-height: 1.3; }
  .summary { color: var(--graphite); }
  .date { font-size: 0.85rem; color: var(--graphite); }
</style>
